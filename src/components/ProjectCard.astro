---
/**
 * ProjectCard — tarjeta individual de proyecto.
 *
 * La tarjeta NO es un enlace envolvente: un proyecto puede tener dos destinos
 * (repositorio y sitio en vivo) o ninguno (repositorio privado), y anidar
 * enlaces dentro de un <a> no es HTML válido. Por eso los enlaces son
 * explícitos, al pie de la tarjeta.
 */
import type { Project } from '../data/projects';
import { t, type Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
  index: number;
}
const { project, lang, index } = Astro.props;
const tr = t(lang);

// Sin `repo` el proyecto es privado: se describe, pero no se enlaza a un 404.
const repoUrl = project.repo
  ? `https://github.com/ruben-salas20/${project.repo}`
  : null;
---

<article
  class="group border border-line bg-surface/40 p-6 transition-[translate,border-color,background-color] duration-300 hover:-translate-y-1 hover:border-accent/55 hover:bg-surface"
>
  <div class="flex items-baseline justify-between gap-4">
    <div class="flex flex-wrap items-baseline gap-3">
      <span class="font-mono text-xs text-faint">/{String(index + 1).padStart(2, '0')}</span>

      {
        repoUrl ? (
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-display text-xl text-ink transition-colors hover:text-accent"
          >
            <h3>{project.name}</h3>
          </a>
        ) : (
          <h3 class="font-display text-xl text-ink">{project.name}</h3>
        )
      }

      {
        project.status && (
          <span class="border border-line px-2 py-0.5 font-mono text-xs text-prompt">
            {project.status[lang]}
          </span>
        )
      }
    </div>
    <span class="shrink-0 font-mono text-xs text-faint">{project.year}</span>
  </div>

  <p class="mt-3 max-w-[58ch] text-sm leading-relaxed text-muted">
    {project.desc[lang]}
  </p>

  <div class="mt-4 flex flex-wrap gap-2">
    {
      project.stack.map((tech) => (
        <span class="font-mono text-xs text-faint">{tech}</span>
      ))
    }
  </div>

  <!-- Pie: enlaces disponibles, o el aviso de repositorio privado. -->
  <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2">
    {
      repoUrl && (
        <a
          href={repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${tr.work.viewRepo}: ${project.name}`}
          class="tap-target link-underline inline-flex items-center gap-1.5 font-mono text-xs text-accent"
        >
          {tr.work.viewRepo}
          <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
            →
          </span>
        </a>
      )
    }

    {
      project.live && (
        <a
          href={project.live}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${tr.work.viewLive}: ${project.name}`}
          class="tap-target link-underline inline-flex items-center gap-1.5 font-mono text-xs text-accent"
        >
          {tr.work.viewLive} ↗
        </a>
      )
    }

    {
      !repoUrl && (
        <span class="inline-flex items-center gap-2 font-mono text-xs text-faint">
          <span class="h-1 w-1 rounded-full bg-faint" aria-hidden="true" />
          {tr.work.privateRepo}
        </span>
      )
    }
  </div>
</article>

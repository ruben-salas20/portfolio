---
/**
 * Article — la página de un artículo en una de las dos rutas.
 *
 * Si existen las dos versiones, son traducciones: cada página es canonical
 * de sí misma y declara a la otra con hreflang. Si solo existe una, la
 * página del otro idioma es una versión de respaldo: menús en su idioma,
 * texto en el original y un aviso. El respaldo apunta su canonical al
 * original y no declara hreflang, porque para un buscador son la misma
 * página; por eso tampoco entra en el sitemap (ver astro.config.mjs).
 */
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SiteHeader from './SiteHeader.astro';
import { t, type Lang } from '../i18n/ui';
import { articleHref, articlesPath, formatDate, type ArticleView } from '../data/articles';

interface Props {
  lang: Lang;
  article: ArticleView;
}
const { lang, article } = Astro.props;
const { entry, slug } = article;
const tr = t(lang);
const { Content } = await render(entry);
const paths = { es: articleHref('es', slug), en: articleHref('en', slug) };
const isFallback = article.lang !== lang;
---

<Layout
  title={`${entry.data.title} — Rubén Salas`}
  description={entry.data.description}
  lang={lang}
  paths={article.bilingual ? paths : null}
  canonicalPath={paths[article.bilingual ? lang : article.lang]}
>
  <SiteHeader lang={lang} otherLangHref={paths[lang === 'es' ? 'en' : 'es']} />

  <main>
    <p class="muted"><a href={articlesPath[lang]}>← {tr.articles.back}</a></p>
    {isFallback && <p class="notice">{tr.articles.onlyOtherLang}</p>}
    <!-- Los data-* llevan los textos del reproductor de audio, de los
         artefactos y del botón de copiar en el idioma de la interfaz; los
         scripts no leen ui.ts. -->
    <article
      lang={article.lang}
      data-lang={lang}
      data-play={tr.articles.player.play}
      data-pause={tr.articles.player.pause}
      data-seek={tr.articles.player.seek}
      data-of={tr.articles.player.of}
      data-copy={tr.code.copy}
      data-copied={tr.code.copied}
    >
      <h1 class="page-title">{entry.data.title}</h1>
      <p class="article-meta muted" lang={lang}>
        <time datetime={entry.data.date.toISOString().slice(0, 10)}>
          {formatDate(entry.data.date, lang)}
        </time>
        {entry.data.translatedWithAI && <span class="tag">{tr.articles.translatedWithAI}</span>}
      </p>
      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
</Layout>

<script>
  import '../scripts/media';
  import '../scripts/copy';
</script>

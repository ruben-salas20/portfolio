---
/**
 * ArticleList — la página con todos los artículos, del más reciente al más
 * antiguo. Las páginas de cada idioma solo hacen <ArticleList lang="..." />.
 */
import Layout from '../layouts/Layout.astro';
import SiteHeader from './SiteHeader.astro';
import { t, type Lang } from '../i18n/ui';
import { getArticles, articleHref, articlesPath, formatDate } from '../data/articles';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const articles = await getArticles();
const otherLang: Lang = lang === 'es' ? 'en' : 'es';
---

<Layout
  title={`${tr.articles.title} — Rubén Salas`}
  description={tr.articles.description}
  lang={lang}
  paths={articlesPath}
>
  <SiteHeader lang={lang} otherLangHref={articlesPath[otherLang]} />

  <main>
    <h1 class="page-title">{tr.articles.title}</h1>
    {
      articles.length === 0 ? (
        <p class="muted">{tr.articles.empty}</p>
      ) : (
        <ul class="article-list">
          {articles.map((article) => (
            <li>
              <a href={articleHref(lang, article.id)} lang="es">{article.data.title}</a>
              <time datetime={article.data.date.toISOString().slice(0, 10)}>
                {formatDate(article.data.date, lang)}
              </time>
              <p lang="es">{article.data.description}</p>
            </li>
          ))}
        </ul>
      )
    }
    <p class="muted"><a href="/rss.xml">RSS</a></p>
  </main>
</Layout>

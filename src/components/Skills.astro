---
/**
 * Skills — tecnologías agrupadas por categoría.
 * Cada grupo es una fila: etiqueta a la izquierda, "chips" a la derecha.
 */
import { t, type Lang } from '../i18n/ui';
import { skillGroups } from '../data/skills';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
---

<section id="skills" class="reveal border-t border-line py-20 lg:py-24">
  <p class="font-mono text-xs tracking-[0.2em] text-accent">{tr.skills.kicker}</p>
  <h2 class="mt-4 font-display text-3xl font-medium text-ink sm:text-[2.4rem]">
    {tr.skills.title}
  </h2>
  <p class="mt-3 max-w-[52ch] text-sm text-faint">{tr.skills.note}</p>

  <div class="mt-9">
    {
      skillGroups.map((group) => (
        <div class="flex flex-col gap-3 border-t border-line py-5 sm:flex-row sm:gap-8">
          <p class="shrink-0 pt-1 font-mono text-xs text-faint sm:w-44">
            {group.label[lang]}
          </p>
          <div class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <span class="border border-line bg-surface px-2.5 py-1 font-mono text-xs text-muted">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

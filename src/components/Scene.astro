---
/**
 * Scene — arranca la escena en pixel art. Hay dos juegos de franjas y nunca
 * se ven a la vez: desde 1280 px, las de los márgenes (`.zone-margin`, las
 * pone cada `Section` con su prop `scene`); por debajo, una sola bajo la
 * cabecera (`.zone-mobile`, en Portfolio.astro). Aquí se elige el juego según
 * el ancho y se pasan los textos de los bocadillos en el idioma de la página.
 */
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<script is:inline type="application/json" id="scene-text" set:html={JSON.stringify(t(lang).scene)} />

<script>
  import { startScene, type SceneText } from '../scripts/scene';

  const text: SceneText = JSON.parse(document.getElementById('scene-text')!.textContent!);
  const margins = [...document.querySelectorAll<HTMLElement>('.zone-margin')];
  const mobile = [...document.querySelectorAll<HTMLElement>('.zone-mobile')];

  // El mismo umbral que en global.css: ver el comentario de `.zone`.
  const wide = matchMedia('(min-width: 1280px)');
  let stop: (() => void) | null = null;
  let running: HTMLElement[] = [];

  // Al cruzar el umbral (girar una tableta, redimensionar la ventana) se
  // desmonta la escena de un juego de franjas y se monta en el otro.
  function sync() {
    const zones = wide.matches ? margins : mobile;
    mobile.forEach((zone) => (zone.hidden = wide.matches));
    if (zones === running) return;
    stop?.();
    running.forEach((zone) => zone.replaceChildren());
    running = zones;
    stop = zones.length > 0 ? startScene(zones, text) : null;
  }

  sync();
  wide.addEventListener('change', sync);
</script>

---
/**
 * Hero — la primera pantalla. Prompt de terminal + titular grande.
 * Las clases `animate-fade-up` + `animation-delay` crean una entrada
 * escalonada al cargar la página (stagger).
 */
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
---

<section id="home" class="flex min-h-[86vh] flex-col justify-center py-16">
  <p
    class="animate-fade-up font-mono text-sm text-prompt"
    style="animation-delay: 0.05s"
  >
    {tr.hero.prompt}
    <span class="cursor-blink text-accent">▋</span>
  </p>

  <h1
    class="animate-fade-up mt-7 max-w-[20ch] font-display text-display-sm font-medium text-ink sm:text-display-lg lg:text-display-xl"
    style="animation-delay: 0.16s"
  >
    {tr.hero.headline}
  </h1>

  <p
    class="animate-fade-up mt-7 max-w-[54ch] text-base leading-relaxed text-muted sm:text-lg"
    style="animation-delay: 0.3s"
  >
    {tr.hero.lead}
  </p>

  <div
    class="animate-fade-up mt-9 flex flex-wrap items-center gap-3"
    style="animation-delay: 0.42s"
  >
    <a
      href="#work"
      class="inline-flex items-center gap-2 bg-accent px-5 py-2.5 text-sm font-medium text-base transition-colors hover:bg-ink"
    >
      {tr.hero.ctaWork}
      <span aria-hidden="true">→</span>
    </a>
    <a
      href="#contact"
      class="inline-flex items-center gap-2 border border-line px-5 py-2.5 text-sm text-ink transition-colors hover:border-accent hover:text-accent"
    >
      {tr.hero.ctaContact}
    </a>
  </div>
</section>

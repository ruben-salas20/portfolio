---
/**
 * Sidebar — barra lateral fija (estilo "Danny portfolio").
 * En escritorio queda fija a la izquierda; en móvil se vuelve
 * una cabecera apilada arriba del contenido.
 */
import { t, contactInfo, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);

// Items de navegación: cada uno apunta a una sección de la página.
const navItems = [
  { id: 'home', label: tr.nav.home },
  { id: 'about', label: tr.nav.about },
  { id: 'skills', label: tr.nav.skills },
  { id: 'work', label: tr.nav.work },
  { id: 'contact', label: tr.nav.contact },
];

// El toggle de idioma apunta a la misma página en el otro idioma.
// El español es el idioma por defecto y vive en la raíz; el inglés en "/en/".
const isEn = lang === 'en';
---

<aside
  class="flex flex-col gap-10 border-b border-line bg-surface/50 px-7 py-8 backdrop-blur-sm lg:fixed lg:inset-y-0 lg:left-0 lg:w-[270px] lg:justify-between lg:gap-0 lg:border-r lg:border-b-0"
>
  <!-- Marca: monograma + nombre + rol -->
  <div class="flex items-center gap-4 lg:flex-col lg:items-start lg:gap-5">
    <a href={isEn ? '/en/' : '/'} class="flex items-center gap-4 lg:flex-col lg:items-start lg:gap-5">
      <span
        class="grid h-11 w-11 place-items-center border border-line bg-elevated font-mono text-sm font-medium text-accent"
      >
        rs
      </span>
      <div>
        <p class="font-display text-xl leading-none text-ink">Rubén Salas</p>
        <p class="mt-1.5 font-mono text-xs tracking-wide text-faint">
          {tr.sidebar.role}
        </p>
      </div>
    </a>
  </div>

  <!-- Navegación principal -->
  <nav class="flex flex-wrap gap-x-6 gap-y-2 lg:flex-col lg:gap-0">
    {
      navItems.map((item, i) => (
        <a
          href={`#${item.id}`}
          data-nav
          class="group flex items-center gap-3 py-1.5 transition-colors lg:py-2.5"
        >
          <span class="nav-bar h-px w-2 bg-faint transition-[width,background-color] duration-300 group-hover:w-5 group-hover:bg-accent" />
          <span class="nav-index font-mono text-xs text-faint transition-colors">
            0{i + 1}
          </span>
          <span class="nav-label text-sm text-muted transition-colors group-hover:text-ink">
            {item.label}
          </span>
        </a>
      ))
    }
  </nav>

  <!-- Pie de la sidebar: estado, idioma, enlaces -->
  <div class="flex flex-col gap-5">
    <!-- Estado de disponibilidad -->
    <div class="flex items-center gap-2.5">
      <span class="relative flex h-2 w-2">
        <span
          class="absolute inline-flex h-full w-full animate-ping rounded-full bg-prompt opacity-60"
        ></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-prompt"></span>
      </span>
      <span class="font-mono text-xs text-muted">{tr.sidebar.available}</span>
    </div>

    <div class="flex items-center justify-between">
      <!-- Enlace al código fuente -->
      <a
        href={contactInfo.github}
        target="_blank"
        rel="noopener noreferrer"
        class="tap-target font-mono text-xs text-faint transition-colors hover:text-accent"
      >
        GitHub ↗
      </a>

      <!--
        Toggle de idioma ES / EN.
        El idioma activo se marca con `aria-current` y con un subrayado, no solo
        con el color: quien no distingue el acento del gris necesita una segunda
        señal, y un lector de pantalla sin `aria-current` anuncia dos enlaces
        idénticos. El valor es `page` y no `true` porque los dos enlaces apuntan
        a páginas distintas, así que el lector anuncia "página actual".
        El borde va en ambos (transparente en el inactivo) para que activar uno
        u otro no desplace la fila un píxel.
      -->
      <div class="flex items-center gap-3 font-mono text-xs">
        <a
          href="/"
          aria-current={isEn ? undefined : 'page'}
          class={`tap-target [--tap-inset-x:-0.3rem] border-b px-1 transition-colors ${isEn ? 'border-transparent text-faint hover:text-ink' : 'border-accent text-accent'}`}
        >
          ES
        </a>
        <a
          href="/en/"
          aria-current={isEn ? 'page' : undefined}
          class={`tap-target [--tap-inset-x:-0.3rem] border-b px-1 transition-colors ${isEn ? 'border-accent text-accent' : 'border-transparent text-faint hover:text-ink'}`}
        >
          EN
        </a>
      </div>
    </div>

    <p class="hidden font-mono text-xs text-faint lg:block">{tr.footer.year}</p>
  </div>
</aside>

---
/**
 * Projects — sección "Proyectos". Encabezado + lista de ProjectCard.
 */
import { t, contactInfo, type Lang } from '../i18n/ui';
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
---

<section id="work" class="reveal border-t border-line py-20 lg:py-24">
  <p class="font-mono text-xs tracking-[0.2em] text-accent">{tr.work.kicker}</p>
  <h2 class="mt-4 font-display text-3xl font-medium text-ink sm:text-[2.4rem]">
    {tr.work.title}
  </h2>
  <p class="mt-3 max-w-[56ch] text-sm text-faint">{tr.work.lead}</p>

  <!-- Nota honesta sobre desarrollo asistido por IA -->
  <div class="mt-6 border-l-2 border-accent/45 bg-surface/50 p-4">
    <p class="font-mono text-[11px] text-prompt">// note</p>
    <p class="mt-1.5 max-w-[60ch] text-sm leading-relaxed text-muted">
      {tr.work.aiNote}
    </p>
  </div>

  <div class="mt-9 grid gap-4">
    {
      projects.map((project, i) => (
        <ProjectCard project={project} lang={lang} index={i} />
      ))
    }
  </div>

  <a
    href={contactInfo.github}
    target="_blank"
    rel="noopener noreferrer"
    class="link-underline mt-7 inline-block font-mono text-xs text-muted hover:text-ink"
  >
    {tr.work.allRepos} ↗
  </a>
</section>

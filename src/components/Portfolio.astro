---
/**
 * Portfolio — ensambla la página completa.
 * Existe para NO repetir esta estructura en cada idioma:
 * las páginas (es / en) solo hacen <Portfolio lang="..." />.
 */
import Layout from '../layouts/Layout.astro';
import Section from './Section.astro';
import ProjectCard from './ProjectCard.astro';
import Scene from './Scene.astro';
import SiteHeader from './SiteHeader.astro';
import { t, type Lang } from '../i18n/ui';
import { projects } from '../data/projects';
import { skills } from '../data/skills';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);

// El español vive en la raíz y el inglés en /en/.
const otherLangHref = lang === 'es' ? '/en/' : '/';
---

<Layout title={tr.meta.title} description={tr.meta.description} lang={lang}>
  <SiteHeader lang={lang} otherLangHref={otherLangHref} home />

  <!-- Franja de la escena para móvil y tableta; en escritorio la escena va
       en los márgenes (ver Scene.astro). -->
  <div class="zone zone-mobile" aria-hidden="true" hidden></div>

  <main>
    <Section title={tr.about.title} scene="left">
      <p>{tr.about.intro}</p>
      <p>{tr.about.howIWork}</p>
    </Section>

    <Section title={tr.now.title} scene="right">
      <ul class="now">
        {
          tr.now.items.map((item) => (
            // En una sola línea: un salto entre el lead y el texto mete un
            // espacio antes de la coma ("harness , mi agente…").
            <li>{'href' in item ? <a href={item.href}>{item.lead}</a> : <strong>{item.lead}</strong>}{item.text}</li>
          ))
        }
      </ul>
    </Section>

    <Section title={tr.work.title} scene="left">
      {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
    </Section>

    <Section title={tr.skills.title}>
      <dl class="skills">
        <dt>{tr.skills.use}</dt>
        <dd>{skills.use.join(', ')}</dd>
        <dt>{tr.skills.learning}</dt>
        <dd>{skills.learning[lang].join(', ')}</dd>
      </dl>
    </Section>
  </main>

  <Scene lang={lang} />
</Layout>


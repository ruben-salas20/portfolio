---
/**
 * Portfolio — ensambla la página completa.
 * Existe para NO repetir esta estructura en cada idioma:
 * las páginas (es / en) solo hacen <Portfolio lang="..." />.
 */
import Layout from '../layouts/Layout.astro';
import Section from './Section.astro';
import ProjectCard from './ProjectCard.astro';
import { t, contactInfo, type Lang } from '../i18n/ui';
import { projects } from '../data/projects';
import { skills } from '../data/skills';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);

// El español vive en la raíz y el inglés en /en/.
const otherLangHref = lang === 'es' ? '/en/' : '/';
---

<Layout title={tr.meta.title} description={tr.meta.description} lang={lang}>
  <header class="site-header">
    <div>
      <h1>Rubén Salas</h1>
      <p class="available">{tr.header.available}</p>
    </div>
    <nav>
      <a href={`mailto:${contactInfo.email}`}>{tr.header.email}</a>
      <a href={contactInfo.github}>GitHub</a>
      <a href={contactInfo.linkedin}>LinkedIn</a>
      <a
        href={otherLangHref}
        hreflang={lang === 'es' ? 'en' : 'es'}
        lang={lang === 'es' ? 'en' : 'es'}>{tr.header.otherLang}</a
      >
      <button type="button" class="theme-toggle" aria-label={tr.header.themeToggle} hidden>
        <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
        <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
    </nav>
  </header>

  <main>
    <Section title={tr.about.title}>
      <p>{tr.about.intro}</p>
      <p>{tr.about.howIWork}</p>
    </Section>

    <Section title={tr.now.title}>
      <ul class="now">
        {
          tr.now.items.map((item) => (
            // En una sola línea: un salto entre el lead y el texto mete un
            // espacio antes de la coma ("harness , mi agente…").
            <li>{'href' in item ? <a href={item.href}>{item.lead}</a> : <strong>{item.lead}</strong>}{item.text}</li>
          ))
        }
      </ul>
    </Section>

    <Section title={tr.work.title}>
      {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
    </Section>

    <Section title={tr.skills.title}>
      <dl class="skills">
        <dt>{tr.skills.use}</dt>
        <dd>{skills.use.join(', ')}</dd>
        <dt>{tr.skills.learning}</dt>
        <dd>{skills.learning[lang].join(', ')}</dd>
      </dl>
    </Section>
  </main>
</Layout>

<script>
  // Botón de tema. El tema guardado se aplica antes en el <head> de
  // Layout.astro; aquí solo se destapa el botón y se atiende el clic.
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
  button.hidden = false;
  button.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.dataset.theme ??
      (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    // Los dos theme-color pasan a apuntar al fondo elegido, no al del sistema.
    const bg = getComputedStyle(document.body).backgroundColor;
    document
      .querySelectorAll('meta[name="theme-color"]')
      .forEach((meta) => meta.setAttribute('content', bg));
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Sin almacenamiento (modo privado, etc.) el cambio dura hasta recargar.
    }
  });
</script>

---
/**
 * SiteHeader — la cabecera de todas las páginas: nombre, disponibilidad,
 * enlaces y botón de tema.
 *
 * En la portada el nombre es el <h1>. En el resto de páginas el <h1> es el
 * título de la página, así que el nombre pasa a ser un enlace a la portada.
 */
import { t, contactInfo, type Lang } from '../i18n/ui';
import { articlesPath, getArticles } from '../data/articles';
import { recipesPath } from '../data/recipes';

interface Props {
  lang: Lang;
  /** Ruta de esta misma página en el otro idioma. */
  otherLangHref: string;
  home?: boolean;
}
const { lang, otherLangHref, home = false } = Astro.props;
const tr = t(lang);
const homeHref = lang === 'es' ? '/' : '/en/';
// Sin artículos publicados, el enlace llevaría a una lista vacía. En
// `npm run dev` los borradores cuentan, así que ahí sale siempre.
const hasArticles = (await getArticles(lang)).length > 0;
---

<header class="site-header">
  <div>
    {
      home ? (
        <h1 class="site-name">Rubén Salas</h1>
      ) : (
        <p class="site-name">
          <a href={homeHref}>Rubén Salas</a>
        </p>
      )
    }
    <p class="available">{tr.header.available}</p>
  </div>
  <nav>
    {hasArticles && <a href={articlesPath[lang]}>{tr.header.articles}</a>}
    <a href={recipesPath[lang]}>{tr.header.recipes}</a>
    <!-- Contacto con iconos de línea, del mismo tamaño y grosor que los del
         botón de tema. El nombre va en aria-label para quien no ve el
         icono, y en title para quien pasa el cursor. -->
    <a class="icon-link" href={`mailto:${contactInfo.email}`} aria-label={tr.header.email} title={tr.header.email}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
        <path d="m3 7 9 6 9-6" />
      </svg>
    </a>
    <a class="icon-link" href={contactInfo.github} aria-label="GitHub" title="GitHub">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
      </svg>
    </a>
    <a class="icon-link" href={contactInfo.linkedin} aria-label="LinkedIn" title="LinkedIn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="4" />
        <path d="M8 11v5M8 8v.01M12 16v-5M16 16v-3a2 2 0 1 0-4 0" />
      </svg>
    </a>
    <a class="icon-link" href={contactInfo.x} aria-label="X" title="X">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 4l11.733 16H20L8.267 4z" />
        <path d="m4 20 6.768-6.768m2.46-2.46L20 4" />
      </svg>
    </a>
    <a
      href={otherLangHref}
      hreflang={lang === 'es' ? 'en' : 'es'}
      lang={lang === 'es' ? 'en' : 'es'}>{tr.header.otherLang}</a
    >
    <button type="button" class="theme-toggle" aria-label={tr.header.themeToggle} hidden>
      <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
      </svg>
      <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
    </button>
  </nav>
</header>

<script>
  // Botón de tema. El tema guardado se aplica antes en el <head> de
  // Layout.astro; aquí solo se destapa el botón y se atiende el clic.
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
  button.hidden = false;
  button.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.dataset.theme ??
      (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    // Los dos theme-color pasan a apuntar al fondo elegido, no al del sistema.
    const bg = getComputedStyle(document.body).backgroundColor;
    document
      .querySelectorAll('meta[name="theme-color"]')
      .forEach((meta) => meta.setAttribute('content', bg));
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Sin almacenamiento (modo privado, etc.) el cambio dura hasta recargar.
    }
  });
</script>

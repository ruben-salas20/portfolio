---
/**
 * About — sección "Sobre mí". Encabezado de sección + tres párrafos.
 */
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
---

<section id="about" class="reveal border-t border-line py-20 lg:py-24">
  <p class="font-mono text-xs tracking-[0.2em] text-accent">{tr.about.kicker}</p>
  <h2 class="mt-4 font-display text-3xl font-medium text-ink sm:text-[2.4rem]">
    {tr.about.title}
  </h2>

  <div class="mt-8 flex max-w-[60ch] flex-col gap-5 leading-relaxed text-muted">
    <p>{tr.about.p1}</p>
    <p>{tr.about.p2}</p>
    <p>{tr.about.p3}</p>
  </div>
</section>

---
/**
 * Section — una fila de la página: el título en una columna estrecha a la
 * izquierda y el contenido a la derecha. En móvil las dos columnas se apilan
 * (ver `.section` en global.css).
 *
 * `scene` añade una franja de la escena de los márgenes a ese lado de la
 * sección, solo en escritorio (ver Scene.astro). La primera franja de la
 * página es la de Rubén.
 */
interface Props {
  title: string;
  scene?: 'left' | 'right';
}
const { title, scene } = Astro.props;
---

<section class="section">
  {scene && <div class="zone zone-margin" data-side={scene} aria-hidden="true" />}
  <h2>{title}</h2>
  <div class="section-body">
    <slot />
  </div>
</section>

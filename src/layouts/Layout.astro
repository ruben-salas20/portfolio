---
/**
 * Layout base — el "esqueleto HTML" que envuelve toda página.
 * Carga el CSS global y define el <head>: canonical, hreflang, Open Graph,
 * Twitter Card y JSON-LD. El único JavaScript es el del botón de tema.
 */
import '../styles/global.css';
import { t, contactInfo, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
}

const { title, description, lang } = Astro.props;
const tr = t(lang);

// `Astro.site` sale de `site` en astro.config.mjs (con www: es el host
// canónico real). Todas las URLs absolutas de abajo se derivan de ahí.
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL('/og-image.png', site);

// El español vive en la raíz y el inglés en /en/. Con solo una página por
// idioma basta con declarar las dos rutas; si el sitio crece, esto hay que
// derivarlo de Astro.url.pathname.
const alternates = [
  { hreflang: 'es', href: new URL('/', site) },
  { hreflang: 'en', href: new URL('/en/', site) },
  { hreflang: 'x-default', href: new URL('/', site) },
];

// JSON-LD: ata la entidad "Rubén Salas" a sus perfiles de forma legible por
// máquina. `alternateName` recoge la grafía sin tilde que usan el dominio,
// el correo y GitHub, para que no se lean como dos personas distintas.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Rubén Salas',
  alternateName: 'Ruben Salas',
  url: site.toString(),
  image: ogImage.toString(),
  jobTitle: tr.meta.jobTitle,
  description: tr.meta.description,
  email: `mailto:${contactInfo.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Armenia',
    addressRegion: 'Quindío',
    addressCountry: 'CO',
  },
  sameAs: [contactInfo.github, contactInfo.linkedin],
  knowsLanguage: ['es', 'en'],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!--
      Favicon: monograma "rs".
      El .ico va primero como respaldo para navegadores sin soporte de SVG;
      los modernos prefieren el SVG por ser el más específico.
    -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Mismos colores que --bg en global.css, uno por esquema. El script de
         abajo y el botón de tema los reescriben si hay un tema elegido. -->
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    <!--
      Tema elegido con el botón de la cabecera. Va inline y en el <head>, no
      como módulo, para aplicarse antes del primer pintado: si esperara al
      final del documento, la página parpadearía con el tema del sistema.
    -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme;
          const bg = theme === 'dark' ? '#111111' : '#ffffff';
          document
            .querySelectorAll('meta[name="theme-color"]')
            .forEach((meta) => meta.setAttribute('content', bg));
        }
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- URL oficial de esta página, y su equivalente en el otro idioma -->
    <link rel="canonical" href={canonical} />
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }

    <!-- Open Graph: cómo se ve el sitio al compartirlo en redes -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Rubén Salas" />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <meta
      property="og:locale:alternate"
      content={lang === 'es' ? 'en_US' : 'es_CO'}
    />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter/X: sin esto la tarjeta sale en formato pequeño -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </head>

  <body>
    <slot />
  </body>
</html>

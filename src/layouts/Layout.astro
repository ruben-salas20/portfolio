---
/**
 * Layout base — el "esqueleto HTML" que envuelve toda página.
 * Carga las fuentes, el CSS global, define el <head> y aporta
 * el fondo atmosférico y los scripts de interacción.
 */
import '../styles/global.css';
import { t, contactInfo, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
}

const { title, description, lang } = Astro.props;
const tr = t(lang);

// `Astro.site` sale de `site` en astro.config.mjs (con www: es el host
// canónico real). Todas las URLs absolutas de abajo se derivan de ahí.
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL('/og-image.png', site);

// El español vive en la raíz y el inglés en /en/. Con solo una página por
// idioma basta con declarar las dos rutas; si el sitio crece, esto hay que
// derivarlo de Astro.url.pathname.
const alternates = [
  { hreflang: 'es', href: new URL('/', site) },
  { hreflang: 'en', href: new URL('/en/', site) },
  { hreflang: 'x-default', href: new URL('/', site) },
];

// JSON-LD: ata la entidad "Rubén Salas" a sus perfiles de forma legible por
// máquina. `alternateName` recoge la grafía sin tilde que usan el dominio,
// el correo y GitHub, para que no se lean como dos personas distintas.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Rubén Salas',
  alternateName: 'Ruben Salas',
  url: site.toString(),
  image: ogImage.toString(),
  jobTitle: tr.sidebar.role,
  description: tr.meta.description,
  email: `mailto:${contactInfo.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Armenia',
    addressRegion: 'Quindío',
    addressCountry: 'CO',
  },
  sameAs: [contactInfo.github],
  worksFor: { '@type': 'Organization', name: 'VAECOS' },
  knowsLanguage: ['es', 'en'],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!--
      Favicon: monograma "rs", el mismo de la sidebar.
      El .ico va primero como respaldo para navegadores sin soporte de SVG;
      los modernos prefieren el SVG por ser el más específico.
    -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#14161b" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- URL oficial de esta página, y su equivalente en el otro idioma -->
    <link rel="canonical" href={canonical} />
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }

    <!-- Open Graph: cómo se ve el sitio al compartirlo en redes -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Rubén Salas" />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <meta
      property="og:locale:alternate"
      content={lang === 'es' ? 'en_US' : 'es_CO'}
    />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter/X: sin esto la tarjeta sale en formato pequeño -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />

    <!--
      Fuentes: Fraunces (display), Hanken Grotesk (texto), JetBrains Mono
      (código). Autoalojadas — las declara @font-face en global.css.
      Las tres se usan por encima del pliegue, y como la página no carga
      imágenes ni scripts externos, precargarlas las tres es lo óptimo:
      arrancan junto al CSS en vez de esperar a que este las descubra.
    -->
    <link
      rel="preload"
      href="/fonts/fraunces-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/hanken-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body class="min-h-screen antialiased">
    <!--
      Salto al contenido: antes del <main> hay nueve paradas de teclado
      (marca, cinco enlaces de nav, GitHub y los dos de idioma), y se repiten
      en cada carga. Invisible hasta que recibe el foco.
    -->
    <a
      href="#home"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-base"
    >
      {tr.a11y.skipToContent}
    </a>

    <!-- Fondo atmosférico: malla de puntos sutil + halo de color. -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10">
      <div
        class="absolute inset-0"
        style="background-image: radial-gradient(circle at 1px 1px, rgba(139,192,208,0.055) 1px, transparent 0); background-size: 34px 34px;"
      >
      </div>
      <div
        class="absolute inset-0"
        style="background: radial-gradient(ellipse 70% 45% at 78% -8%, rgba(136,192,208,0.10), transparent 62%);"
      >
      </div>
    </div>

    <slot />

    <script>
      // --- Reveal al hacer scroll -----------------------------------------
      // Cada elemento con clase .reveal aparece cuando entra en pantalla.
      const revealObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 },
      );
      document
        .querySelectorAll('.reveal')
        .forEach((el) => revealObserver.observe(el));

      // --- Scroll-spy de la navegación ------------------------------------
      // Resalta en la sidebar el link de la sección visible.
      const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
      const sections = document.querySelectorAll<HTMLElement>('section[id]');
      const spyObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              navLinks.forEach((link) =>
                link.classList.toggle(
                  'nav-active',
                  link.getAttribute('href') === `#${entry.target.id}`,
                ),
              );
            }
          }
        },
        { rootMargin: '-40% 0px -55% 0px' },
      );
      sections.forEach((section) => spyObserver.observe(section));
    </script>
  </body>
</html>

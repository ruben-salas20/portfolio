{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/_recetas/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/(en/?)?",
      "headers": { "Vary": "User-Agent" },
      "continue": true
    },
    {
      "src": "/",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?:curl|Wget|HTTPie|xh)/.*" }],
      "dest": "/index.txt"
    },
    {
      "src": "/en/?",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?:curl|Wget|HTTPie|xh)/.*" }],
      "dest": "/en/index.txt"
    }
  ]
}
